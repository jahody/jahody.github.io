---
// Monochrome dot/line figure for a project, drawn in a 240×180 viewBox and set in a dashed
// frame with micro-labels in its corners. Unknown slugs fall back to the contribution grid.
interface Props {
  slug: string;
  stats: [string, string];
  /** Top-right badge: a hosted demo ('live') or published work ('paper'). */
  badge?: 'live' | 'paper';
  size?: 'card' | 'page';
}
const { slug, stats, badge, size = 'card' } = Astro.props;

const r2 = (n: number) => Math.round(n * 100) / 100;
// Deterministic pseudo-random in [0, 1) so every build draws the same figure.
const rand = (i: number) => {
  const x = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
  return x - Math.floor(x);
};
const polar = (cx: number, cy: number, r: number, a: number) => ({
  x: r2(cx + r * Math.cos(a)),
  y: r2(cy + r * Math.sin(a)),
});

// CycleSync: a 28-day ring in four phases around a mini calendar; the marker steps one day at a time.
const CX = 120;
const CY = 92;
const dayAngle = (d: number) => -Math.PI / 2 + (d / 28) * Math.PI * 2;
const cycleDays = Array.from({ length: 28 }, (_, d) => ({ ...polar(CX, CY, 62, dayAngle(d)), phase: Math.floor(d / 7), d }));
const cycleTicks = [0, 7, 14, 21].map((d) => ({
  a: polar(CX, CY, 70, dayAngle(d - 0.5)),
  b: polar(CX, CY, 78, dayAngle(d - 0.5)),
}));
const calendar = Array.from({ length: 28 }, (_, i) => ({ x: 96.5 + (i % 7) * 7, y: CY - 13 + Math.floor(i / 7) * 7, row: Math.floor(i / 7) }));

// SurveyMaster: taxonomy tree; dot stacks are papers per leaf, with one dead and one overloaded leaf.
const l1 = [52, 120, 188];
const leaves = l1.flatMap((x) => [x - 22, x, x + 22]);
const stack = [3, 5, 2, 4, 0, 3, 8, 4, 2];
const DEAD = 4;
const OVERLOADED = 6;

// agentSwarm: router in the middle, seven providers around it, one cooling down.
const providers = Array.from({ length: 7 }, (_, i) => {
  const a = -Math.PI / 2 + (i / 7) * Math.PI * 2;
  const x = r2(120 + 90 * Math.cos(a));
  const y = r2(90 + 64 * Math.sin(a));
  const len = Math.hypot(x - 120, y - 90);
  const ux = (x - 120) / len;
  const uy = (y - 90) / len;
  return { x, y, i, s: { x: r2(120 + ux * 21), y: r2(90 + uy * 21) }, e: { x: r2(x - ux * 11), y: r2(y - uy * 11) } };
});
const COOLDOWN = 4;
const ring = providers.map((p, i) => {
  const q = providers[(i + 1) % providers.length];
  const len = Math.hypot(q.x - p.x, q.y - p.y);
  const ux = (q.x - p.x) / len;
  const uy = (q.y - p.y) / len;
  return {
    a: { x: r2(p.x + ux * 13), y: r2(p.y + uy * 13) },
    b: { x: r2(q.x - ux * 13), y: r2(q.y - uy * 13) },
    m: { x: r2((p.x + q.x) / 2), y: r2((p.y + q.y) / 2) },
  };
});
const routerDots: { x: number; y: number }[] = [];
for (let gx = -12; gx <= 12; gx += 4) {
  for (let gy = -12; gy <= 12; gy += 4) {
    if (Math.hypot(gx, gy) <= 13) routerDots.push({ x: 120 + gx, y: 90 + gy });
  }
}

// LLM clustering benchmark: 5 methods × (3 datasets × 3 encoders) = 45 cells. Exactly one beats the
// best classical baseline by more than its seed variance: SPILL on Banking77 with instructor-large.
const methods = ['FSC', 'LSCK', 'kLLM', 'SPILL', 'CEQ'];
const datasets = ['B77', 'C150', 'MAS'];
const CELL = 16;
const GX = 41;
const GY = 44;
const cells = methods.flatMap((_, m) =>
  [0, 1, 2].flatMap((b) =>
    [0, 1, 2].map((e) => ({ x: GX + b * 66 + e * 20, y: GY + m * 20, win: m === 3 && b === 0 && e === 2 })),
  ),
);

// SpeedCam: a tracked car on the road, its earlier centroids behind it, and the displacement
// over time that becomes the speed readout.
const trail = [48, 74, 100, 126].map((x, i) => ({ x, r: r2(1.6 + i * 0.55), i }));

// Fallback: a contribution-style grid, denser toward recent weeks.
const contrib = Array.from({ length: 7 * 24 }, (_, i) => {
  const col = Math.floor(i / 7);
  const v = rand(i + 1) * (0.55 + (0.5 * col) / 23);
  return { x: 25 + col * 8, y: 63 + (i % 7) * 8, level: v < 0.3 ? 0 : v < 0.55 ? 1 : v < 0.75 ? 2 : 3 };
});
---

<div class={`frame ${size}`}>
  <svg viewBox="0 0 240 180" aria-hidden="true">
    {
      slug === 'cyclesync' && (
        <g>
          <circle class="s faint" cx={CX} cy={CY} r="46" stroke-dasharray="1 3.5" />
          {cycleTicks.map((t) => <line class="s" x1={t.a.x} y1={t.a.y} x2={t.b.x} y2={t.b.y} />)}
          {cycleDays.map((p) =>
            p.phase === 0 ? (
              <circle class="f" cx={p.x} cy={p.y} r="3.4" />
            ) : p.phase === 1 ? (
              <circle class="h" cx={p.x} cy={p.y} r="2.6" />
            ) : p.phase === 2 ? (
              <circle class="f" cx={p.x} cy={p.y} r="2.3" />
            ) : (
              <circle class="f" cx={p.x} cy={p.y} r="1.3" />
            ),
          )}
          <circle class="s" cx={cycleDays[14].x} cy={cycleDays[14].y} r="6" />
          {calendar.map((c) => (
            <rect class={c.row === 0 ? 'f' : 'h faint'} x={c.x} y={c.y} width="5" height="5" />
          ))}
          <g class="spin">
            <line class="s" x1={CX} y1={CY - 72} x2={CX} y2={CY - 80} />
            <path class="f" d={`M${CX} ${CY - 69} l-3.5 -6 h7 z`} />
          </g>
        </g>
      )
    }

    {
      slug === 'surveymaster' && (
        <g>
          <rect class="h" x="113" y="18" width="14" height="14" />
          {[0, 1, 2].flatMap((i) => [0, 1, 2].map((j) => <circle class="f" cx={116.5 + i * 3.5} cy={21.5 + j * 3.5} r="0.75" />))}
          <path class="s" d="M120 32 V45 M52 45 H188" />
          {l1.map((x) => (
            <>
              <path class="s" d={`M${x} 45 V60 M${x} 67 V82 M${x - 22} 82 H${x + 22}`} />
              <rect class="f" x={x - 3.5} y="60" width="7" height="7" />
            </>
          ))}
          {leaves.map((x, i) => (
            <>
              <path class="s" d={`M${x} 82 V96`} />
              {i === DEAD ? (
                <>
                  <rect class="h" x={x - 3.5} y="96" width="7" height="7" stroke-dasharray="1.5 1.5" />
                  <path class="s" d={`M${x - 4} 110 l8 8 M${x + 4} 110 l-8 8`} />
                </>
              ) : (
                <rect class={i === OVERLOADED ? 'f' : 'h'} x={x - 3.5} y="96" width="7" height="7" />
              )}
              {Array.from({ length: stack[i] }, (_, k) => (
                <circle class="f" cx={x} cy={112 + k * 6} r="1.6" />
              ))}
            </>
          ))}
        </g>
      )
    }

    {
      slug === 'agentswarm' && (
        <g>
          {ring.map((r) => (
            <>
              <line class="s faint" x1={r.a.x} y1={r.a.y} x2={r.b.x} y2={r.b.y} stroke-dasharray="1 3" />
              <rect class="f" x={r.m.x - 1.3} y={r.m.y - 1.3} width="2.6" height="2.6" />
            </>
          ))}
          {providers.map((p) =>
            p.i === COOLDOWN ? (
              <line class="s faint" x1={p.s.x} y1={p.s.y} x2={p.e.x} y2={p.e.y} stroke-dasharray="2 2" />
            ) : (
              <>
                <line class="s" x1={p.s.x} y1={p.s.y} x2={p.e.x} y2={p.e.y} stroke-width="0.8" />
                <line class={`flow${p.i % 2 ? ' rev' : ''}`} x1={p.s.x} y1={p.s.y} x2={p.e.x} y2={p.e.y} />
              </>
            ),
          )}
          {providers.map((p) => (
            <>
              <circle class="h" cx={p.x} cy={p.y} r="10.5" stroke-dasharray={p.i === COOLDOWN ? '2 2' : undefined} />
              <text class="t" x={p.x} y={p.y + 2.2} font-size="6.5" text-anchor="middle">{`P${p.i + 1}`}</text>
            </>
          ))}
          <circle class="h" cx="120" cy="90" r="20" stroke-width="1.3" />
          {routerDots.map((d) => <circle class="f" cx={d.x} cy={d.y} r="0.9" />)}
        </g>
      )
    }

    {
      slug === 'llm-clustering-benchmark' && (
        <g>
          {datasets.map((d, b) => (
            <text class="t muted" x={GX + b * 66 + 28} y={GY - 8} font-size="6.5" text-anchor="middle">{d}</text>
          ))}
          {methods.map((m, i) => (
            <text class="t muted" x={GX - 6} y={GY + i * 20 + 10.5} font-size="6.5" text-anchor="end">{m}</text>
          ))}
          {cells.map((c) =>
            c.win ? (
              <rect class="f pulse" x={c.x} y={c.y} width={CELL} height={CELL} />
            ) : (
              <>
                <rect class="h" x={c.x} y={c.y} width={CELL} height={CELL} stroke-width="0.8" />
                <circle class="ff" cx={c.x + CELL / 2} cy={c.y + CELL / 2} r="1" />
              </>
            ),
          )}
        </g>
      )
    }

    {
      slug === 'speedcam' && (
        <g>
          <text class="t" x="18" y="40" font-size="28" font-weight="500">47</text>
          <text class="t muted" x="19" y="51" font-size="7">KM/H</text>
          <path class="s faint" d="M12 130 H228" stroke-dasharray="1 3" />
          {trail.map((p) => <circle class="f blink" cx={p.x} cy="98" r={p.r} style={`animation-delay:${p.i * 0.25}s`} />)}
          <path class="s" stroke-width="1.6" d="M144 80 v-10 h10 M210 70 h10 v10 M220 116 v10 h-10 M154 126 h-10 v-10" />
          <path class="s" d="M176 98 h12 M182 92 v12" stroke-width="1.2" />
          <path class="s" d="M48 146 H182 M48 141 v10 M182 141 v10" />
          <text class="t muted" x="115" y="162" font-size="7.5" text-anchor="middle">Δx / Δt</text>
        </g>
      )
    }

    {
      !['cyclesync', 'surveymaster', 'agentswarm', 'llm-clustering-benchmark', 'speedcam'].includes(slug) && (
        <g>
          {contrib.map((c) => (
            <rect class={`lv${c.level}`} x={c.x} y={c.y} width="6" height="6" />
          ))}
        </g>
      )
    }
  </svg>
  {badge === 'live' && <span class="corner tr">Live <i></i></span>}
  {badge === 'paper' && <span class="corner tr paper">Paper <i></i></span>}
  <span class="corner bl">{stats[0]}</span>
  <span class="corner br">{stats[1]}</span>
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    padding: 24px 14px;
    border: 1px dashed var(--dash);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
  }
  /* Full-width banner on a project page; the 4:3 drawing sits centred in it. */
  .frame.page { aspect-ratio: 3 / 1; padding: 30px 20px; }
  @media (max-width: 640px) { .frame.page { aspect-ratio: 4 / 3; } }
  svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .corner {
    position: absolute;
    font: 500 9.5px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bl { left: 10px; bottom: 9px; }
  .br { right: 10px; bottom: 9px; }
  .tr { right: 10px; top: 9px; display: flex; align-items: center; gap: 5px; }
  .tr i { width: 6px; height: 6px; border-radius: 50%; background: var(--live); }
  .tr.paper { color: var(--fg); }
  .tr.paper i { border-radius: 0; background: var(--fg); }

  .s { fill: none; stroke: var(--fg); stroke-width: 1; }
  .f { fill: var(--fg); }
  .h { fill: var(--bg); stroke: var(--fg); stroke-width: 1; }
  .ff { fill: var(--faint); }
  .faint { stroke: var(--faint); }
  .t { font-family: var(--mono); fill: var(--fg); }
  .t.muted { fill: var(--muted); }
  .t.inv { fill: var(--bg); }
  .flow { stroke: var(--fg); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 0.1 10; }
  .lv0 { fill: var(--bg); stroke: var(--line); stroke-width: 0.8; }
  .lv1 { fill: #d9d9dc; }
  .lv2 { fill: #9a9ea5; }
  .lv3 { fill: var(--fg); }

  @media (prefers-reduced-motion: no-preference) {
    .spin { transform-box: view-box; transform-origin: 120px 92px; animation: spin 28s steps(28) infinite; }
    .flow { animation: flow 1.4s linear infinite; }
    .flow.rev { animation-direction: reverse; }
    .pulse { animation: pulse 2.4s ease-in-out infinite; }
    .blink { animation: blink 1.6s ease-in-out infinite; }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes flow { to { stroke-dashoffset: -10.1; } }
  @keyframes pulse { 50% { opacity: 0.3; } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }
</style>
