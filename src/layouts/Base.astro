---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Projects and tools by Adam Zlamal.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header>
        <a class="brand" href="/">Adam Zlamal</a>
        <nav>
          <a href="/#projects">Projects</a>
          <a href="https://github.com/jahody">GitHub</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer>© {new Date().getFullYear()} Adam Zlamal</footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #111214;
    --muted: #6b7078;
    --faint: #9aa0a8;
    --line: #ececee;
    --accent: #3b5bdb;
    --radius: 10px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.65 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .page { max-width: 680px; margin: 0 auto; padding: 0 20px; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 28px 0 0; }
  header nav { display: flex; gap: 24px; }
  header nav a { color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 0.15s; }
  header nav a:hover { color: var(--fg); }
  .brand { font-weight: 600; font-size: 0.95rem; color: var(--fg); text-decoration: none; letter-spacing: -0.01em; }
  main { padding: 72px 0 40px; }
  a { color: var(--accent); text-underline-offset: 3px; }
  h1 { font-size: 2.4rem; line-height: 1.15; letter-spacing: -0.03em; font-weight: 600; margin: 0 0 16px; }
  h2 { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin: 56px 0 14px; }
  p { margin: 0 0 14px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 52ch; }
  footer { color: var(--faint); font-size: 0.82rem; padding: 32px 0 40px; border-top: 1px solid var(--line); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 14px 0 0; list-style: none; }
  .tags li { font-size: 0.75rem; color: var(--muted); background: #f5f5f7; border-radius: 999px; padding: 2px 10px; }
  @media (max-width: 520px) {
    main { padding-top: 48px; }
    h1 { font-size: 1.9rem; }
  }
</style>
