---
interface Props {
  title: string;
  description?: string;
  /** Full-width content (the project grid) instead of the reading column. */
  wide?: boolean;
}
const { title, description = 'Projects and tools by Adam Zlamal.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const isProjects = path === '/' || path.startsWith('/projects');
const isCv = path.startsWith('/cv');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="0" y="0" width="7" height="7" />
            <rect x="9" y="9" width="7" height="7" />
            <rect class="o" x="9.4" y="0.4" width="6.2" height="6.2" />
            <rect class="o" x="0.4" y="9.4" width="6.2" height="6.2" />
          </svg>
          Adam Zlamal
        </a>
        <nav>
          <a href="/" aria-current={isProjects ? 'page' : undefined}>Projects</a>
          <a href="/cv/" aria-current={isCv ? 'page' : undefined}>CV</a>
        </nav>
        <a class="cta" href="https://github.com/jahody">GitHub</a>
      </div>
    </header>
    <main class={wide ? 'wide' : 'narrow'}><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #0b0b0c;
    --muted: #5d6168;
    --faint: #a3a7ad;
    --line: #e7e7e9;
    --dash: #cfd0d4;
    --soft: #f7f7f8;
    --live: #1f9d55;
    --radius: 999px;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }
  * { box-sizing: border-box; }
  /* Reserve the scrollbar's space on every page so the centred layout doesn't shift between short and long pages. */
  html { -webkit-text-size-adjust: 100%; scrollbar-gutter: stable; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.65 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  header.site { padding: 0 24px; background: var(--bg); position: sticky; top: 0; z-index: 10; }
  /* Same content width as main.wide, so the rule under the header lines up with the grid and CV rows. */
  .bar {
    max-width: 1072px;
    margin: 0 auto;
    border-bottom: 1px solid var(--line);
    height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .brand {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* The mark (same as public/favicon.svg): a 2×2 grid with its diagonal filled. */
  .brand svg { width: 16px; height: 16px; fill: var(--fg); }
  .brand svg .o { fill: none; stroke: var(--fg); stroke-width: 0.8; }
  .bar nav { display: flex; gap: 36px; }
  .bar nav a { color: var(--fg); font-size: 0.9rem; text-decoration: none; opacity: 0.75; transition: opacity 0.15s; }
  .bar nav a:hover, .bar nav a[aria-current='page'] { opacity: 1; }
  .cta {
    justify-self: end;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    padding: 8px 20px;
    border-radius: var(--radius);
    transition: background 0.15s;
  }
  .cta:hover { background: #2a2c31; }

  main.narrow { max-width: 728px; margin: 0 auto; padding: 64px 24px 72px; }
  main.wide { max-width: 1120px; margin: 0 auto; padding: 40px 24px 72px; }

  a { color: var(--fg); text-underline-offset: 3px; }
  h1 { font-size: 2.4rem; line-height: 1.12; letter-spacing: -0.035em; font-weight: 500; margin: 0 0 16px; }
  h2 {
    font: 500 0.72rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 56px 0 14px;
  }
  p { margin: 0 0 14px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 52ch; }
  .mono { font: 500 0.72rem/1.4 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 14px 0 0; list-style: none; }
  .tags li {
    font: 400 0.68rem/1.4 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 7px;
  }

  @media (max-width: 640px) {
    header.site { padding: 0 16px; }
    .bar { grid-template-columns: auto 1fr auto; gap: 16px; height: 56px; }
    .bar nav { justify-self: end; gap: 18px; }
    .cta { padding: 6px 14px; font-size: 0.82rem; }
    main.narrow { padding: 40px 16px 56px; }
    main.wide { padding: 24px 16px 56px; }
    h1 { font-size: 1.9rem; }
  }
</style>
