---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Adam Zlamal — Projects">
  <section>
    <h1>Tools I've built.</h1>
    <p class="lead">
      A collection of projects around LLMs, research tooling, and small apps. Some run right here in
      your browser; others are documented as showcases.
    </p>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="card" href={`/projects/${p.slug}/`}>
            <div class="top">
              <h3>{p.title}</h3>
              <span class={`badge ${p.status}`}>{p.status === 'live' ? 'Live demo' : 'Showcase'}</span>
            </div>
            <p>{p.tagline}</p>
            <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; gap: 16px; }
  .card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 20px;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover { border-color: var(--accent); }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  h3 { margin: 0; font-size: 1.15rem; }
  .card p { margin: 6px 0 0; color: var(--muted); }
  .badge { font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
  .badge.live { background: #d8f3e0; color: #14532d; }
  .badge.showcase { background: var(--line); color: var(--muted); }
  @media (prefers-color-scheme: dark) {
    .badge.live { background: #14352a; color: #7ee2a8; }
  }
</style>
