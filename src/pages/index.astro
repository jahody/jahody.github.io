---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Adam Zlamal — Projects">
  <section id="projects">
    <h2>Projects</h2>
    <ul class="list">
      {
        projects.map((p) => (
          <li>
            <a class="row" href={`/projects/${p.slug}/`}>
              <div class="text">
                <div class="name">
                  {p.title}
                  {p.status === 'live' && <span class="live">Live</span>}
                </div>
                <p>{p.tagline}</p>
                <ul class="tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .list > li { border-bottom: 1px solid var(--line); }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 4px;
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius);
    transition: background 0.15s, padding 0.15s;
  }
  .row:hover { background: #fafafb; padding-left: 12px; padding-right: 12px; }
  .name { font-weight: 600; letter-spacing: -0.01em; display: flex; align-items: center; gap: 10px; }
  .row p { color: var(--muted); margin: 4px 0 0; font-size: 0.95rem; }
  .live {
    font-size: 0.68rem;
    font-weight: 500;
    color: #0f7a3d;
    background: #e7f6ed;
    border-radius: 999px;
    padding: 1px 8px;
  }
  .arrow { color: var(--faint); transition: transform 0.15s, color 0.15s; }
  .row:hover .arrow { transform: translateX(3px); color: var(--fg); }
</style>
