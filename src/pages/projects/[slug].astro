---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<Base title={`${project.title} — Adam Zlamal`} description={project.tagline}>
  <a class="back mono" href="/#projects">← Projects</a>
  <div class="meta mono">{project.category}</div>
  <Figure
    slug={project.slug}
    stats={project.stats}
    badge={project.status === 'live' ? 'live' : project.paper ? 'paper' : undefined}
    size="page"
  />

  <h1>{project.title}</h1>
  <p class="lead">{project.tagline}</p>

  {
    project.paper && (
      <p class="cite">
        <span class="mono">Paper · {project.paper.venue}</span>
        “{project.paper.title}”
      </p>
    )
  }

  {
    (project.demo || project.repo) && (
      <div class="actions">
        {project.demo && <a class="btn primary" href={project.demo}>Open the app</a>}
        {project.repo && <a class="btn" href={project.repo}>View on GitHub</a>}
      </div>
    )
  }

  <ul class="tags">{project.tags.map((t) => <li>{t}</li>)}</ul>

  <h2>What it does</h2>
  {project.summary.map((s) => <p class="text">{s}</p>)}

  <h2>Highlights</h2>
  <ul class="bullets">{project.highlights.map((h) => <li>{h}</li>)}</ul>

  {
    project.slug === 'cyclesync' && (
      <p class="note">
        Sign-in uses Google OAuth and is unverified, so Google shows a warning screen. Only your own
        calendar is touched, and nothing is sent to me. See the{' '}
        <a href="/apps/cycle/privacy.html">privacy notes</a>.
      </p>
    )
  }
</Base>

<style>
  .back { display: inline-block; margin-bottom: 28px; text-decoration: none; }
  .back:hover { color: var(--fg); }
  .meta { margin-bottom: 12px; font-size: 0.66rem; }
  h1 { margin-top: 36px; }
  /* The figure spans the full column; running text keeps a readable measure. */
  .text, .bullets { max-width: 72ch; }
  .cite { margin: 20px 0 0; padding: 12px 16px; border: 1px dashed var(--dash); font-size: 0.95rem; max-width: 60ch; }
  .cite .mono { display: block; margin-bottom: 4px; color: var(--fg); font-size: 0.66rem; }
  .actions { display: flex; gap: 10px; margin: 28px 0 0; flex-wrap: wrap; }
  .btn {
    padding: 8px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--fg);
    font-weight: 500;
    font-size: 0.9rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .btn:hover { border-color: var(--faint); }
  .btn.primary { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .btn.primary:hover { background: #2a2c31; }
  .bullets { padding-left: 1.1em; margin: 0; }
  .bullets li { margin: 8px 0; padding-left: 4px; }
  .bullets li::marker { color: var(--faint); content: '— '; }
  .note { margin-top: 48px; padding: 14px 18px; border: 1px dashed var(--dash); color: var(--muted); font-size: 0.88rem; max-width: 72ch; }
</style>
