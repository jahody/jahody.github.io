---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<Base title={`${project.title} — Adam Zlamal`} description={project.tagline}>
  <a class="back" href="/#projects">← Projects</a>
  <h1>{project.title}</h1>
  <p class="lead">{project.tagline}</p>

  {
    (project.demo || project.repo) && (
      <div class="actions">
        {project.demo && <a class="btn primary" href={project.demo}>Open the app</a>}
        {project.repo && <a class="btn" href={project.repo}>View on GitHub</a>}
      </div>
    )
  }

  <ul class="tags">{project.tags.map((t) => <li>{t}</li>)}</ul>

  <h2>What it does</h2>
  {project.summary.map((s) => <p>{s}</p>)}

  <h2>Highlights</h2>
  <ul class="bullets">{project.highlights.map((h) => <li>{h}</li>)}</ul>

  {
    project.slug === 'cyclesync' && (
      <p class="note">
        Sign-in uses Google OAuth and is unverified, so Google shows a warning screen. Only your own
        calendar is touched, and nothing is sent to me. See the{' '}
        <a href="/apps/cycle/privacy.html">privacy notes</a>.
      </p>
    )
  }
</Base>

<style>
  .back { display: inline-block; margin-bottom: 32px; color: var(--muted); font-size: 0.9rem; text-decoration: none; }
  .back:hover { color: var(--fg); }
  .actions { display: flex; gap: 10px; margin: 28px 0 0; flex-wrap: wrap; }
  .btn {
    padding: 9px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--fg);
    font-weight: 500;
    font-size: 0.92rem;
    transition: border-color 0.15s, background 0.15s;
  }
  .btn:hover { border-color: var(--faint); }
  .btn.primary { background: var(--fg); border-color: var(--fg); color: #fff; }
  .btn.primary:hover { background: #2a2c31; }
  .bullets { padding-left: 1.1em; margin: 0; }
  .bullets li { margin: 8px 0; padding-left: 4px; }
  .bullets li::marker { color: var(--faint); }
  .note { margin-top: 48px; padding: 14px 18px; background: #fafafb; border: 1px solid var(--line); border-radius: var(--radius); color: var(--muted); font-size: 0.88rem; }
</style>
